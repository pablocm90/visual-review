{
  "name": "@pablocm90/visual-review",
  "version": "0.2.0",
  "description": "Structural review pages for pull requests, ranges and uncommitted work",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pablocm90/visual-review.git"
  },
  "type": "module",
  "engines": {
    "node": "^22.20.0 || >=24.8.0"
  },
  "os": [
    "!win32"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "visual-review": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "packageManager": "pnpm@10.34.7",
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && vite build && node src/write-schemas.ts",
    "prepack": "pnpm build",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "mutate": "stryker run",
    "review": "vite build --logLevel silent && node src/cli.ts"
  },
  "devDependencies": {
    "@babel/types": "^8.0.6",
    "@biomejs/biome": "^2.5.15",
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/vitest-runner": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "elkjs": "^0.12.0",
    "highlight.js": "11.12.0",
    "jsdom": "^30.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@babel/parser": "^8.0.7",
    "@swc/core": "^1.16.18",
    "dependency-cruiser": "^18.6.0",
    "jsonc-parser": "^3.3.1",
    "tree-sitter-ruby": "0.23.1",
    "tree-sitter-rust": "0.24.0",
    "web-tree-sitter": "0.27.0",
    "zod": "^4.6.7"
  }
}
